#!/usr/bin/env bash
# pbpipe: paste clipboard → pipe through command → copy result back.
# Usage: pbpipe [-t] COMMAND [ARGS...]
#   -t, --tee   Also print the output to stdout.

set -euo pipefail

TEE=false
case "${1:-}" in
    -t|--tee) TEE=true; shift ;;
esac

if [[ $# -eq 0 ]]; then
    printf 'Usage: pbpipe [-t] COMMAND [ARGS...]\n' >&2
    exit 1
fi

result="$(pbpaste | "$@")" || {
    rc=$?
    printf 'pbpipe: command exited %d\n' "$rc" >&2
    exit 1
}

if [[ "$TEE" == true ]]; then
    printf '%s' "$result"
fi

printf '%s' "$result" | pbcopy
