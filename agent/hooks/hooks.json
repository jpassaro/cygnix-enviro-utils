{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "${extensionPath}/hooks/session-start.sh"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "timestamp-injector",
            "type": "command",
            "command": "${extensionPath}/hooks/gemini-prompt-timestamp.sh"
          }
        ]
      }
    ]
  }
}
