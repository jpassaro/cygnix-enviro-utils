#!/bin/bash
# Manages ~/bin: adds it to PATH, defines installables for
# installing/tracking symlinks from the repo's bin/ directory.
# Safe for non-interactive shells.

source_pragma_once "$MY_BASHRC_D"/path  # we need prepend-path

mkdir -p ~/bin
prepend-path ~/bin

if [[ -z "${MY_BASHRC_D:-}" ]]; then
  return 2>/dev/null || true
fi
_INSTALLABLES_BIN="$(cd "$MY_BASHRC_D"/../bin && pwd -P)" || return
_INSTALLABLES_BASE="${_INSTALLABLES_BIN%/bin}"
_INSTALLABLES_EXCLUDE="${_INSTALLABLES_BASE}/.git/info/exclude"

function _installables_status() {
  local name="$1"
  local tracked="${_INSTALLABLES_BIN}/${name}"
  local local_bin=~/bin/"$name"
  if [[ -L "$local_bin" ]]; then
    echo installed
  elif [[ -f "$local_bin" && ! -x "$local_bin" ]]; then
    echo ignored-installable
  elif [[ -x "$tracked" && ! -e "$local_bin" ]]; then
    echo installable
  elif [[ -f "$local_bin" && -x "$local_bin" && ! -L "$local_bin" ]]; then
    if grep -qx "bin/${name}" "$_INSTALLABLES_EXCLUDE" 2>/dev/null; then
      echo ignored-local
    elif [[ "$(file --mime-encoding -b "$local_bin")" == binary ]]; then
      echo binary
    elif [[ -e "$tracked" ]]; then
      if cmp -s "$local_bin" "$tracked"; then
        echo identical
      elif git -C "$_INSTALLABLES_BASE" ls-files --error-unmatch "bin/${name}" >/dev/null 2>&1 \
           && git -C "$_INSTALLABLES_BASE" diff --quiet -- "bin/${name}" 2>/dev/null; then
        echo diverged
      else
        echo conflict
      fi
    else
      echo importable
    fi
  else
    echo unknown
  fi
}

function installables() {
  local thisfunc="${FUNCNAME[0]}"
  if [[ -z "${_INSTALLABLES_BIN:-}" ]]; then
    echo >&2 "${thisfunc}: MY_BASHRC_D was not set when bashrc.d/installables was sourced"
    return 1
  fi

  case "$1" in
    help)
      cat <<EOF
Usage: ${thisfunc} [subcommand] [name]

Subcommands:
  (none)         List installable and importable scripts
  quiet          One-line summary of what's available
  interactive    Walk through all available actions interactively
  ignored        Show permanently ignored scripts
  status NAME    Show status of a single script
  install NAME   Symlink bin/NAME from this repo into ~/bin
  ignore NAME    Permanently ignore (installable or importable)
  import NAME    Import ~/bin/NAME into this repo's bin/
  help           Show this help
EOF
      return 0
      ;;
    status)
      local name="$2"
      [[ -n "$name" ]] || { echo >&2 "usage: ${thisfunc} status NAME"; return 1; }
      _installables_status "$name"
      return 0
      ;;
    install)
      local name="$2" tracked local_bin
      [[ -n "$name" ]] || { echo >&2 "usage: ${thisfunc} install NAME"; return 1; }
      tracked="${_INSTALLABLES_BIN}/${name}"
      local_bin=~/bin/"$name"
      [[ -x "$tracked" ]] || { echo >&2 "${name} not found in ${_INSTALLABLES_BIN}"; return 1; }
      case "$(_installables_status "$name")" in
        installed)
          echo >&2 "${name} is already installed (symlink exists at ${local_bin})"
          return 1
          ;;
        ignored-installable)
          echo "${name} was previously ignored; removing placeholder"
          rm -v "$local_bin"
          ;;
        installable) ;;
        identical)
          echo "${name} is identical to tracked; replacing with symlink"
          rm -v "$local_bin"
          ;;
        *)
          echo >&2 "${name} is not installable"
          return 1
          ;;
      esac
      ln -sv "$tracked" "$local_bin"
      return 0
      ;;
    ignore)
      local name="$2" local_bin
      [[ -n "$name" ]] || { echo >&2 "usage: ${thisfunc} ignore NAME"; return 1; }
      local_bin=~/bin/"$name"
      case "$(_installables_status "$name")" in
        installable)
          echo "ignoring installable ${name}; rm ${local_bin} to reverse"
          touch "$local_bin"
          chmod 644 "$local_bin"
          ;;
        importable)
          echo "ignoring local ${name}; remove from ${_INSTALLABLES_EXCLUDE} to reverse"
          echo "bin/${name}" >>"$_INSTALLABLES_EXCLUDE"
          ;;
        installed)
          echo >&2 "${name} is currently installed (symlink at ${local_bin}); remove it first"
          return 1
          ;;
        ignored-installable|ignored-local)
          echo >&2 "${name} is already ignored"
          return 1
          ;;
        *)
          echo >&2 "${name} is not a pending installable or importable"
          return 1
          ;;
      esac
      return 0
      ;;
    import)
      local name="$2" tracked local_bin
      [[ -n "$name" ]] || { echo >&2 "usage: ${thisfunc} $1 NAME"; return 1; }
      local_bin=~/bin/"$name"
      tracked="${_INSTALLABLES_BIN}/${name}"
      case "$(_installables_status "$name")" in
        importable) ;;
        installed)
          echo >&2 "${name} is already a symlink in ~/bin; nothing to import"
          return 1
          ;;
        *)
          echo >&2 "${name} not found as an importable executable in ~/bin"
          return 1
          ;;
      esac
      if [[ -e "$tracked" ]] ; then
        echo "warning: overwriting existing ${tracked}"
      fi
      mv -v "$local_bin" "$tracked"
      ln -sv "$tracked" "$local_bin"
      return 0
      ;;
  esac

  if [[ "$1" == quiet ]] ; then

      function _when_missing() {
        true
      }
      function _when_eligible() {
        true
      }
      function _after() {
          echo ${1:+"$1 installables can be added."} \
            ${2:+"$2 new scripts can be added to version control."} \
            "Call ${thisfunc} for more."
      }

  elif [[ "$1" == ignored ]] ; then
      local deletion="to reverse any of these decisions, delete the file as listed above"
      echo in source control but never to be installed:
      find ~/bin -maxdepth 1 -type f -empty -perm 644
      echo "$deletion"
      echo
      echo on local but never to be added to source control:
      git -C "$_INSTALLABLES_BASE" \
          ls-files --others --ignored \
          --exclude-from "$_INSTALLABLES_EXCLUDE" \
          --full-name \
          "$_INSTALLABLES_BIN"/* \
        | awk -v basedir="$_INSTALLABLES_BASE" '! /^\// {print basedir "/" $0}'
      echo "${deletion} and remove it from ${_INSTALLABLES_EXCLUDE}"
      return 0

  elif [[ "$1" == interactive ]] ; then

      local num_installed=0 num_ignored=0 num_added=0 num_checkin_ignored
      function _when_missing() {
        local reply installable="${1}"
        local tracked="${_INSTALLABLES_BIN}/${installable}" local_bin=~/bin/"$installable"
        read -r -p "Do you want to install ${installable}? [(y)es/(S)KIP/(n)ever] " reply
        case "${reply,,}" in
          y*)
            echo installing "$installable"
            ln -sv "$tracked" "$local_bin"
            ((num_installed++))
            ;;
          n*)
            echo "okay, we will ignore ${installable} from now on, rm ${local_bin} to reverse this decision."
            touch "$local_bin"
            chmod 644 "$local_bin"
            ((num_ignored++))
            ;;
          *)
            echo skipping "$installable"
            ;;
        esac
      }
      function _when_eligible() {
        local reply eligible="${1}" existing="$2"
        local tracked="${_INSTALLABLES_BIN}/${eligible}" local_bin=~/bin/"$eligible"
        local prompt="Do you want to add ${eligible} to source control?"
        prompt="${prompt}${existing:+ (may overwrite ${existing})}"
        read -r -p "${prompt} [(y)es/(S)kip/(n)ever] " reply
        case "${reply,,}" in
          y*)
            echo adding "$eligible"
            mv -v "$local_bin" "$tracked"
            ln -sv "$tracked" "$local_bin"
            ((num_added++))
            ;;
          n*)
            echo ignoring "$eligible"
            echo "bin/${eligible}" >>"$_INSTALLABLES_EXCLUDE"
            ((num_checkin_ignored++))
            ;;
          *)
            echo skipping "$eligible"
            ;;
        esac
      }
      function _after() {
        echo ${1:+"Checked ${1} missing executables, installed ${num_installed}, permanently ignored ${num_ignored}."} \
          ${2:+"Checked ${2} eligible new executables, added ${num_added} to source control, permanently ignored ${num_checkin_ignored}."}
      }

  else

      function _when_missing() {
        echo "$1" can be installed
      }
      function _when_eligible() {
        echo "$1" can be added to source control "${2:+(but it may overwrite $2)}"
      }
      function _after() {
        echo "Call '${thisfunc} interactive' to interactively act on this."
        echo "Call '${thisfunc} ignored' to see which scripts are already being ignored."
      }

  fi

  local path basename num_missing=0 num_eligible=0
  for path in "$_INSTALLABLES_BIN"/* ; do
    [[ -x "$path" ]] || continue
    basename="${path##*/}"
    [[ -e ~/bin/"$basename" ]] || {
      _when_missing "$basename"
      ((num_missing++))
    }
  done
  local existing
  for path in ~/bin/* ; do
    basename="${path##*/}"
    case "$(_installables_status "$basename")" in
      importable)
        existing="${_INSTALLABLES_BIN}/${basename}"
        [[ -e "$existing" ]] || existing=''
        _when_eligible "$basename" "$existing"
        ((num_eligible++))
        ;;
    esac
  done
  [[ "${num_missing}" -gt 0 ]] || num_missing=
  [[ "${num_eligible}" -gt 0 ]] || num_eligible=
  if [[ -n "${num_missing}${num_eligible}" ]] ; then
    _after "$num_missing" "$num_eligible"
  fi
  unset -f _when_missing _when_eligible _after
}
