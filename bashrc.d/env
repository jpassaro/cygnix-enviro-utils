#!/bin/bash
# shellcheck disable=SC2034
# Non-interactive environment setup: EDITOR, PAGER, LESSOPEN.
# Interactive env setup (prompts, direnv, iterm, jenv) is in env-interactive.

if [[ "${CLAUDECODE:-}" == "1" ]]; then
  export EDITOR="$HOME/bin/no-interactive-edit"
  export PAGER="$HOME/bin/no-interactive-pager"
elif command -v nvim >/dev/null 2>&1 ; then
  export EDITOR=nvim
  export PAGER=less
else
  export EDITOR=vim
  export PAGER=less
fi

# LESSOPEN
# allow less to view gzip and several other non-ascii filetypes

lesspipe=
# shellcheck disable=SC2154
if [[ "$jp_system_type" == linux ]] ; then
  lesspipe=lesspipe
elif [[ "$jp_system_type" == darwin ]] ; then
  lesspipe=lesspipe.sh
fi

if [[ -n "$lesspipe" ]] \
      && check-for-package "$lesspipe" "${lesspipe}, a smarter less reader" ; then
  LESSOPEN="|$(command -v "$lesspipe") %s"
  export LESSOPEN
fi
