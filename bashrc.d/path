#!/bin/bash
# PATH utilities (prepend-path, append-path) and Homebrew initialization.
# Safe for non-interactive shells.

# utilities to easily add paths to your PATH.
# Each one checks for duplicate entries and that the directory exists.

function _can_add() {
  [[ -n "$1" && "$#" == 1 ]] \
    && [[  "$PATH" == *?:"$1":?*
      || "$PATH" == "$1":?*
      || "$PATH" == *?:"$1"
      || "$PATH" == "$1" ]]
}

function prepend-path() {
  local x
  for x ; do
    _can_add "$x" || export PATH="$x":"$PATH"
  done
}

function append-path() {
  local x
  for x ; do
    _can_add "$x" || export PATH="$PATH":"$x"
  done
}

# Initialize Homebrew
if [[ -z "$HOMEBREW_PREFIX" ]] ; then
  for brew_bin in /opt/homebrew/bin/brew /usr/local/bin/brew ; do
    if [[ -x "$brew_bin" ]] ; then
      eval "$("$brew_bin" shellenv)"
      break
    fi
  done
fi

# Fallback for HOMEBREW_PREFIX if shellenv wasn't used but brew is on PATH
if [[ -z "$HOMEBREW_PREFIX" ]] && command -v brew >/dev/null ; then
  export HOMEBREW_PREFIX="$(brew --prefix)"
fi

if [[ -n "$HOMEBREW_PREFIX" ]] ; then
  # Ensure brew's bin is early in PATH
  if [[ "$PATH" != *"$HOMEBREW_PREFIX/bin"*:/usr/bin* ]] ; then
    export PATH="$HOMEBREW_PREFIX/bin:$HOMEBREW_PREFIX/sbin:$PATH"
  fi

  # Helper for GNU utilities if in an AI agent session
  if [[ -n "$GEMINI_CLI$CLAUDECODE$CLAUDE_CODE$CLAUDE" ]] ; then
    for pkg in coreutils findutils gawk gnu-sed gnu-tar grep ; do
      pkg_prefix="$HOMEBREW_PREFIX/opt/$pkg"
      if [[ -d "${pkg_prefix}/libexec/gnubin" ]] ; then
        prepend-path "${pkg_prefix}/libexec/gnubin"
      fi
    done
  fi
fi
