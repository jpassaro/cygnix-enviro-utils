#!/bin/bash

# utilities to easily add paths to your PATH.
# Each one checks for duplicate entries and that the directory exists.

function _can_add() {
  [[ -n "$1" && "$#" == 1 ]] \
    && [[  "$PATH" == *?:"$1":?*
      || "$PATH" == "$1":?*
      || "$PATH" == *?:"$1"
      || "$PATH" == "$1" ]]
}

function prepend-path() {
  for x ; do
    _can_add "$x" || export PATH="$x":"$PATH"
  done
}

function append-path() {
  for x ; do
    _can_add "$x" || export PATH="$PATH":"$x"
  done
}

for localpath in /usr/local/bin /opt/homebrew/bin ; do
  if [[ "$PATH" != *"$localpath"*:/usr/bin* ]] ; then
    # it must come first, even if it was already there
    export PATH="${localpath}:${PATH}"
  fi
done

if [[ -n "$GEMINI_CLI$CLAUDECODE$CLAUDE_CODE$CLAUDE" ]] && command -v brew >/dev/null ; then
  for pkg in coreutils findutils gawk gnu-sed gnu-tar grep ; do
    pkg_prefix="$(brew --prefix "$pkg" 2>/dev/null)" || continue
    if [[ -n "$pkg_prefix" && -d "${pkg_prefix}/libexec/gnubin" ]] ; then
      prepend-path "${pkg_prefix}/libexec/gnubin"
    fi
  done
fi
