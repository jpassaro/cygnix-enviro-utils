#!/bin/bash
# shellcheck disable=SC1090
# SSH agent lifecycle: start agent, add keys, detect stale agents.
# Safe for non-interactive shells: agent startup and env sourcing work,
# but ssh-add-local-keys is stubbed to avoid terminal reads.

# first shamelessly adapted (plagiarized) from some stack exchange thread
# (though I have now added enough of my own stuff to this that I hardly think
# that is still true)

source_pragma_once "$MY_BASHRC_D"/env

# set JP_VERBOSE_SSH=on to see ssh-agent startup logging
JP_VERBOSE_SSH="${JP_VERBOSE_SSH:-off}"

if [[ -z "$JP_VERBOSE_SSH_HINT_SHOWN" && "$JP_VERBOSE_SSH" != on && "$-" == *i* ]] ; then
  echo >&2 "login-utils/ssh-agent: set JP_VERBOSE_SSH=on to enable verbose logging"
  export JP_VERBOSE_SSH_HINT_SHOWN=yes
fi

SSH_HOME="${SSH_HOME:-"$HOME"/.ssh}"
SSH_ENV="${SSH_ENV:-${SSH_HOME}/agent-setup}"
SSH_ENV_LOCK="${SSH_ENV_LOCK:-/tmp/ssh-agent-setup-lock}"

# tries to start the ssh agent, using the atomicity of mkdir to guard
# against race conditions and ensure there is only one agent running.
# If it succeeds in creating the directory, it won the race and so
# creates an SSH agent. It leaves the directory open to prevent other
# processes from creating an agent simultaneously.
# If it fails to acquire the lock by creating the lock directory, it
# waits SSH_ENV_WAIT seconds (default 1), then attempts to use the SSH
# agent created by the other process.
# If this fails, it may mean SSH_ENV_WAIT is too short.
# Another more troubling possibility is that there was no competing
# process creating an SSH agent at all. This should only happen if:
#
# 1. SSH_ENV_LOCK survives a reboot (unlikely since it is in /tmp);
# 2. the agent has died; or
# 3. the agent exists but the SSH_ENV file pointing to it has been
# removed.
#
# We purposefully ask the user to resolve this situation.
# In case of 1 or 2, the lock should be released by rmdir-ing
# SSH_ENV_LOCK, then this function should be run again. If 3 happens,
# you can also do the above; ideally (but optionally), you should
# kill the "rogue" agent first.
function ssh-maybe-start-agent {
  if ssh-check-env-file ; then
    return
  fi
  if mkdir "$SSH_ENV_LOCK" >/dev/null 2>&1 ; then
    [[ "$JP_VERBOSE_SSH" != on ]] || echo >&2 "login-utils/ssh-agent: Initialising new SSH agent..."
    # ssh-agent outputs `echo Agent pid 123;`, which we strip
    ssh-agent | sed '/^echo Agent pid/d' > "${SSH_ENV}"
    [[ "$JP_VERBOSE_SSH" != on ]] || echo >&2 "login-utils/ssh-agent: succeeded"
    chmod 600 "${SSH_ENV}"
    . "${SSH_ENV}"
    [[ "$JP_VERBOSE_SSH" != on ]] || echo >&2 "login-utils/ssh-agent: sourced ${SSH_ENV} (PID ${SSH_AGENT_PID})"
    # Record whether the winner was interactive so race losers can react.
    if [[ "$-" == *i* ]]; then
      echo interactive > "$SSH_ENV_LOCK/shell-type"
    else
      echo non-interactive > "$SSH_ENV_LOCK/shell-type"
    fi
    ssh-add-local-keys

  else
    echo >&2 "login-utils/ssh-agent: avoided race condition, retrying shortly"
    sleep "${SSH_ENV_WAIT:-1}"
    if ! ssh-check-env-file ; then
      cat <<-END_OF_MESSAGE >&2
	------------------OH NO!---------------------------
	Could not find a running ssh-agent after waiting.
	This likely means a stale lock dir was left behind.
	To fix, run:

	  rm -rf ${SSH_ENV_LOCK@Q} && ${FUNCNAME[0]}

	Any other open terminals should then run ssh-check-env-file
	to pick up the new agent.

	See comments in ${BASH_SOURCE[0]} for details.
	END_OF_MESSAGE
      return 1
    fi
    # Agent is running, but if the winner was non-interactive, keys
    # may not have been added. Nudge an interactive user to fix this.
    if [[ "$-" == *i* ]] && \
       [[ -f "$SSH_ENV_LOCK/shell-type" ]] && \
       [[ "$(< "$SSH_ENV_LOCK/shell-type")" == non-interactive ]]; then
      echo >&2 "login-utils/ssh-agent: agent was started by a non-interactive shell,"
      echo >&2 "  so SSH keys may not have been added. Run: ssh-add-local-keys"
    fi
  fi
}

if [[ "$-" == *i* ]]; then
  function ssh-add-local-keys() {
    local pub key
    for pub in "$SSH_HOME"/*.pub ; do
      key="${pub%.pub}"  # shave off the suffix
      if [[ -r "$key" ]] ; then
        ssh-add "$key"
      fi
    done
  }
else
  function ssh-add-local-keys() {
    echo >&2 "ssh-add-local-keys: must be run in an interactive shell."
    echo >&2 "  Open a new terminal and run: ssh-add-local-keys"
    return 1
  }
fi

function ssh-check-env-file() {
  if [[ ! -f "${SSH_ENV}" ]] ; then
    return 1
  fi
  source "${SSH_ENV}"
  if [[ "$JP_VERBOSE_SSH" == on ]] ; then
    echo >&2 "login-utils/ssh-agent: checking for ssh-agent pid $SSH_AGENT_PID"
  fi
  # ps ${SSH_AGENT_PID} doesn't work under cywgin
  # shellcheck disable=SC2009  # because we are okay grepping ps output here
  if ps ${CYGWIN:+-p} "${SSH_AGENT_PID}" | grep -qm1 ssh-agent$ ; then
    if [[ "$JP_VERBOSE_SSH" == on ]] ; then
      echo >&2 "login-utils/ssh-agent: previous ssh-agent ${SSH_AGENT_PID} is still running"
    fi
  else
    if [[ "$JP_VERBOSE_SSH" == on ]] ; then
      echo >&2 "login-utils/ssh-agent: no ssh-agent found"
    fi
    return 1
  fi
}

# Source SSH settings, if applicable

ssh-maybe-start-agent
